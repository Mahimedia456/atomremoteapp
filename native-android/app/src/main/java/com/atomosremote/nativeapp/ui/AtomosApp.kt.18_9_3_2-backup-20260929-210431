@Composable
private fun PairScreen(vm: AtomosViewModel) {
    val selected by vm.selected.collectAsState()
    val state by vm.gattState.collectAsState()
    val bondState by vm.bondState.collectAsState()
    val snapshot by vm.gattSnapshot.collectAsState()
    val tcsPairing by vm.tcsPairingState.collectAsState()
    val tcsRemote by vm.tcsRemoteState.collectAsState()
    val disconnectReason by vm.gattDisconnectReason.collectAsState()
    val s1c by vm.s1cStatus.collectAsState()
    val protocol by vm.protocol.collectAsState()
    val commandStatus by vm.commandStatus.collectAsState()
    val pairingAccepted by vm.pairingCodeAccepted.collectAsState()
    val codeCandidates by vm.pairingCodeCandidates.collectAsState()
    val scanState by vm.scanState.collectAsState()
    val gattEvents by vm.gattEvents.collectAsState()
    val smpPasskey by vm.peripheralSmpPasskey.collectAsState()
    val peripheralState by vm.peripheralState.collectAsState()
    val inboundAddress by vm.peripheralCentralAddress.collectAsState()
    val inboundPairingId by vm.peripheralPairingId.collectAsState()
    val context = LocalContext.current
    var traceMessage by remember { mutableStateOf<String?>(null) }

    val pairingId = selected?.advertisedPairingId ?: snapshot?.pairingId ?: inboundPairingId
    val remoteReady = tcsRemote.available || tcsRemote.linked || s1c.ready || protocol?.canTransmit == true
    val centralLinked = state in setOf("connected", "services-ready", "tcs-pairing", "passive-pair-capture", "pair-discovery") || s1c.ready
    val busy = state == "connecting" || (state == "tcs-pairing" && tcsPairing.phase !in setOf("can-accept", "waiting-for-bcid", "accepted"))
    val staleBond = selected?.device?.bondState == BluetoothDevice.BOND_BONDED && !pairingAccepted && pairingId == null

    Column(Modifier.fillMaxSize().background(Color(0xFF0A0C0D))) {
        AppHeader(
            selected?.name ?: "Connect recorder",
            selected?.address ?: "Shogun Ultra",
            onBack = { vm.stopScan(); vm.stopPairingPresence(); vm.gatt.disconnect(); vm.go(AtomosViewModel.Screen.CONNECT) }
        )

        LazyColumn(
            Modifier.fillMaxSize(),
            contentPadding = PaddingValues(horizontal = 18.dp, vertical = 18.dp),
            verticalArrangement = Arrangement.spacedBy(12.dp)
        ) {
            item {
                Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(6.dp)) {
                    PairStageChip("AG2", selected != null, Modifier.weight(1f))
                    PairStageChip("GATT", centralLinked, Modifier.weight(1f))
                    PairStageChip("CODE", pairingId != null || pairingAccepted, Modifier.weight(1f))
                    PairStageChip("REMOTE", remoteReady, Modifier.weight(1f))
                }
            }

            item {
                Card(colors = CardDefaults.cardColors(containerColor = Color(0xFF151A1C)), shape = RoundedCornerShape(16.dp)) {
                    Column(Modifier.fillMaxWidth().padding(18.dp), horizontalAlignment = Alignment.CenterHorizontally) {
                        Text("PAIRING ID", color = Color(0xFF868D90), fontSize = 10.sp, letterSpacing = 1.2.sp)
                        Spacer(Modifier.height(10.dp))
                        Text(
                            pairingId ?: if (pairingAccepted) "Accepted" else "Waiting…",
                            fontSize = if (pairingId != null) 34.sp else 24.sp,
                            fontWeight = FontWeight.ExtraBold,
                            letterSpacing = if (pairingId != null) 1.2.sp else 0.sp
                        )
                        Spacer(Modifier.height(8.dp))
                        Text(
                            when {
                                remoteReady -> "Recorder control channel confirmed."
                                pairingAccepted -> "Matching code accepted. Official TCS ~CCID acceptance has been sent to SHOGUN."
                                pairingId != null -> "Official AtomRemote-style Connect Name. SHOGUN should show this same 9-digit code. Accept only if it matches exactly."
                                centralLinked -> "AG2 GATT is connected. Starting the recovered official TCS pairing sequence."
                                else -> "Keep Sync Config → Bluetooth / AirGlu BT → Pair open on Shogun Ultra."
                            },
                            color = Color(0xFF868D90),
                            fontSize = 12.sp,
                            lineHeight = 18.sp
                        )
                        smpPasskey?.let { passkey ->
                            Spacer(Modifier.height(10.dp))
                            Text(
                                "Android SMP passkey observed: $passkey (security layer only, not the ATOMOS 9-digit ID)",
                                color = Color(0xFFE8A23B), fontSize = 10.sp, lineHeight = 15.sp
                            )
                        }
                        if (busy) {
                            Spacer(Modifier.height(14.dp))
                            CircularProgressIndicator(Modifier.size(28.dp), strokeWidth = 2.5.dp, color = AtomosCyan)
                        }
                    }
                }
            }

            item {
                Card(colors = CardDefaults.cardColors(containerColor = Color(0xFF10201F)), shape = RoundedCornerShape(14.dp)) {
                    Column(Modifier.fillMaxWidth().padding(14.dp)) {
                        Text("18.3 OFFICIAL TCS PAIRING + REMOTE", color = AtomosCyan, fontSize = 11.sp, fontWeight = FontWeight.Bold)
                        Text(
                            "Pairing keeps the proven official TCS flow: ID slots -> 9-digit Connect Name -> CCID -> BCID -> user confirm -> ~CCID. After acceptance, 18.3 opens the recovered TCS Packet Link on cxtic 12/13 and moves directly to Remote.",
                            color = Color(0xFFB7BFC1), fontSize = 11.sp, lineHeight = 16.sp, modifier = Modifier.padding(top = 5.dp)
                        )
                    }
                }
            }

            if (staleBond) {
                item {
                    Card(colors = CardDefaults.cardColors(containerColor = Color(0xFF2A2115)), shape = RoundedCornerShape(14.dp)) {
                        Column(Modifier.fillMaxWidth().padding(15.dp)) {
                            Text("STALE ANDROID BOND DETECTED", color = Color(0xFFE8A23B), fontSize = 11.sp, fontWeight = FontWeight.Bold)
                            Text(
                                "AG2 is already BONDED before a fresh Pairing ID exists. Clear the Android bond and use Unpair All once on Shogun before another clean capture.",
                                color = Color(0xFFD7C4A5), fontSize = 11.sp, lineHeight = 16.sp, modifier = Modifier.padding(top = 5.dp)
                            )
                            Button(onClick = { vm.clearAndroidBondAndRetry() }, modifier = Modifier.fillMaxWidth().padding(top = 10.dp).height(50.dp)) {
                                Text("RESET STALE BOND + RESTART", fontWeight = FontWeight.Bold)
                            }
                            OutlinedButton(
                                onClick = {
                                    runCatching {
                                        context.startActivity(Intent(Settings.ACTION_BLUETOOTH_SETTINGS).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
                                    }
                                },
                                modifier = Modifier.fillMaxWidth().padding(top = 8.dp).height(46.dp)
                            ) { Text("OPEN ANDROID BLUETOOTH SETTINGS") }
                        }
                    }
                }
            }

            if (!pairingAccepted && codeCandidates.isNotEmpty()) {
                item {
                    Text("PAIRING CODES SEEN IN BLE SCAN", color = Color(0xFF868D90), fontSize = 10.sp, fontWeight = FontWeight.Bold)
                    Text("Use only a code that exactly matches the Shogun screen.", color = Color(0xFF868D90), fontSize = 11.sp)
                }
                items(codeCandidates, key = { "scan-${it.pairingId}-${it.sourceAddress}" }) { candidate ->
                    Card(
                        onClick = { vm.selectPairingCodeCandidate(candidate.pairingId) },
                        colors = CardDefaults.cardColors(containerColor = if (pairingId == candidate.pairingId) Color(0xFF173331) else Color(0xFF1A1F21)),
                        shape = RoundedCornerShape(12.dp)
                    ) {
                        Row(Modifier.fillMaxWidth().padding(13.dp), verticalAlignment = Alignment.CenterVertically) {
                            Column(Modifier.weight(1f)) {
                                Text(candidate.pairingId, fontSize = 19.sp, fontWeight = FontWeight.Bold)
                                Text(
                                    if (candidate.exactAg2Source) "Direct AG2 advertisement" else "Pair-session beacon · ${candidate.hits} hit(s) · ${candidate.rssi} dBm",
                                    color = Color(0xFF868D90), fontSize = 10.sp
                                )
                            }
                            Text(if (pairingId == candidate.pairingId) "SELECTED" else "USE IF MATCH", color = AtomosCyan, fontSize = 10.sp, fontWeight = FontWeight.Bold)
                        }
                    }
                }
            }

            if (!pairingAccepted && pairingId != null) {
                item {
                    Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(10.dp)) {
                        OutlinedButton(onClick = { vm.retryPairingIdScan() }, modifier = Modifier.weight(1f).height(50.dp)) { Text("RESCAN") }
                        Button(
                            onClick = { vm.confirmPairingCodeAndContinue() },
                            enabled = tcsPairing.canAccept,
                            modifier = Modifier.weight(1.5f).height(50.dp)
                        ) {
                            Text(if (tcsPairing.canAccept) "ACCEPT MATCHING CODE" else "WAIT FOR SHOGUN", fontWeight = FontWeight.Bold)
                        }
                    }
                }
            } else if (!pairingAccepted) {
                item {
                    OutlinedButton(onClick = { vm.retryPairingIdScan() }, modifier = Modifier.fillMaxWidth().height(50.dp)) {
                        Text("RECONNECT AG2 + CAPTURE")
                    }
                }
            }

            item {
                Card(colors = CardDefaults.cardColors(containerColor = Color(0xFF151A1C)), shape = RoundedCornerShape(14.dp)) {
                    Column(Modifier.padding(14.dp)) {
                        Text("OFFICIAL TCS PAIR LINK", color = AtomosCyan, fontSize = 10.sp, fontWeight = FontWeight.Bold)
                        Text("Phone advertising: OFF (official central flow)", fontSize = 11.sp, modifier = Modifier.padding(top = 5.dp))
                        Text("TCS phase: ${tcsPairing.phase.uppercase()}", color = AtomosCyan, fontSize = 10.sp)
                        Text("Remote link: ${tcsRemote.phase.uppercase()}", color = if (tcsRemote.available) AtomosCyan else Color(0xFF868D90), fontSize = 10.sp)
                        tcsPairing.slotsAvailable?.let { Text("ID slots available: $it", color = Color(0xFFB7BFC1), fontSize = 10.sp) }
                        tcsPairing.bcid?.let { Text("BCID: 0x%08X".format(it), color = Color(0xFF868D90), fontSize = 9.sp) }
                        tcsPairing.lastError?.let { Text("TCS error: $it", color = AtomosRed, fontSize = 10.sp) }

                        Text("AG2 GATT client: ${state.uppercase()}", color = Color(0xFFB7BFC1), fontSize = 10.sp)
                        Text("Android bond: ${bondState.uppercase()}", color = Color(0xFF868D90), fontSize = 10.sp)
                        Text("AirGlu service: 9383b854-8bee-11e7-bb31-be2e44b06b34", color = Color(0xFF868D90), fontSize = 9.sp)
                        val model = snapshot?.characteristics?.firstOrNull { it.characteristicUuid.equals("9383b110-8bee-11e7-bb79-be2e44b06b34", true) }?.lastValueAscii
                        val session = snapshot?.characteristics?.firstOrNull { it.characteristicUuid.equals("ce8dadf8-b7e0-4d9e-94cd-43f84803b361", true) }?.lastValueHex
                        if (!model.isNullOrBlank()) Text("Recorder identity: $model", color = Color(0xFF868D90), fontSize = 9.sp)
                        if (!session.isNullOrBlank()) Text("Session value ce8d…: $session", color = Color(0xFF868D90), fontSize = 9.sp)
                    }
                }
            }

            if (pairingAccepted && !remoteReady) {
                item {
                    Button(onClick = { vm.startPairingDiscovery() }, modifier = Modifier.fillMaxWidth().height(52.dp)) {
                        Text("OPEN REMOTE", fontWeight = FontWeight.Bold)
                    }
                }
            }

            disconnectReason?.let { reason -> item { Text("Last disconnect: $reason", color = AtomosRed, fontSize = 11.sp) } }
            commandStatus?.let { status -> item { Text(status, color = Color(0xFFB7BFC1), fontSize = 11.sp, lineHeight = 17.sp) } }

            item {
                Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                    OutlinedButton(onClick = { vm.retrySelectedConnection() }, modifier = Modifier.weight(1f)) { Text("RESTART LINK") }
                    OutlinedButton(
                        onClick = {
                            vm.exportPairingTrace().fold(
                                onSuccess = { result ->
                                    traceMessage = result.summary
                                    val share = Intent(Intent.ACTION_SEND).apply {
                                        type = "application/json"
                                        putExtra(Intent.EXTRA_STREAM, result.uri)
                                        addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
                                    }
                                    context.startActivity(Intent.createChooser(share, "Share ATOMOS pairing trace"))
                                },
                                onFailure = { traceMessage = it.message ?: "Pairing trace export failed" }
                            )
                        },
                        modifier = Modifier.weight(1f)
                    ) { Text("SHARE TRACE") }
                }
                traceMessage?.let { Text(it, color = Color(0xFF868D90), fontSize = 9.sp, modifier = Modifier.padding(top = 5.dp)) }
            }

            if (gattEvents.isNotEmpty()) {
                item {
                    Card(colors = CardDefaults.cardColors(containerColor = Color(0xFF111517)), shape = RoundedCornerShape(12.dp)) {
                        Column(Modifier.padding(12.dp)) {
                            Text("CENTRAL GATT TRACE", color = Color(0xFF868D90), fontSize = 9.sp, fontWeight = FontWeight.Bold)
                            gattEvents.takeLast(8).forEach { event ->
                                Text(event, color = Color(0xFF747C7E), fontSize = 8.sp, modifier = Modifier.padding(top = 3.dp))
                            }
                        }
                    }
                }
            }

            item {
                TextButton(onClick = { vm.go(AtomosViewModel.Screen.GATT) }, modifier = Modifier.fillMaxWidth()) { Text("GATT / PROTOCOL INSPECTOR") }
            }
        }
    }
}

@Composable
private fun PairStageChip(label: String, active: Boolean, modifier: Modifier = Modifier) {
    Surface(
        modifier = modifier,
        shape = RoundedCornerShape(8.dp),
        color = if (active) Color(0xFF173331) else Color(0xFF171B1D),
        border = androidx.compose.foundation.BorderStroke(1.dp, if (active) AtomosCyan else Color(0xFF2B3032))
    ) {
        Text(label, color = if (active) AtomosCyan else Color(0xFF575D5F), fontSize = 8.sp, fontWeight = FontWeight.Bold, modifier = Modifier.padding(vertical = 7.dp), textAlign = androidx.compose.ui.text.style.TextAlign.Center)
    }
}

